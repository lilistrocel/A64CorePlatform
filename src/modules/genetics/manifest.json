{
  "module_name": "genetics",
  "display_name": "Genetics Repo",
  "version": "1.0.0",
  "description": "Cross-domain genetics repository and lab traceability tracker — genetic lines, physical accessions with dual G/F generation tracking, clone and cross propagation events, versioned medium recipes and batches, observations and novel-trait promotion",
  "route_prefix": "/api/v1/genetics",
  "dependencies": {
    "core": ">=1.3.0",
    "python": ">=3.11"
  },
  "database_collections": [
    "genetic_lines",
    "genetic_accessions",
    "propagation_events",
    "medium_recipes",
    "medium_batches",
    "genetic_observations"
  ],
  "permissions": [
    "genetics.view",
    "genetics.create",
    "genetics.edit",
    "genetics.propagate",
    "genetics.observe",
    "genetics.media.manage",
    "genetics.line.manage",
    "genetics.promote",
    "genetics.delete",
    "genetics.delete.cascade",
    "genetics.maintenance"
  ],
  "license_required": true,
  "enabled_by_default": true,
  "core_module": true,
  "industries": ["all"],
  "industry_mode": "shared"
}
