# Test results and temporary test files
test-results/
*_test_results_*.json
test_*.spec.ts
test_*.py
test-*.mjs
test_*.mjs
# But track structured test suites under any tests/ directory (not pycache or .pyc files).
# Note: leading `**/` is required so the negation matches nested tests/ dirs like
# `src/modules/<module>/tests/` and `services/<svc>/tests/`, not only top-level `tests/`.
!**/tests/**/*.py
!**/tests/**/__init__.py

# Screenshots and images from testing
*.png
# But track brand source artwork (used for re-exports) and existing tracked logos.
!Logo/*.png
!frontend/user-portal/public/*.png
!public/*.png
!public/admin/*.png
clear-browser-cache.html

