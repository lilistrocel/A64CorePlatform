# Application Settings
APP_NAME=A64 Core Platform API Hub
ENVIRONMENT=development
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database Settings - MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=a64core_db

# Database Settings - MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB_NAME=a64core_db

# Security Settings
SECRET_KEY=change_this_to_a_secure_random_key_in_production
API_KEY_PREFIX=dev_key

# Logging
LOG_LEVEL=INFO

# Admin Credentials (used by cron service)
ADMIN_EMAIL=admin@a64platform.com
ADMIN_PASSWORD=change_this_to_secure_password

# MongoDB Authentication (production)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_this_to_secure_root_password
MONGO_APP_USER=a64core_app
MONGO_APP_PASSWORD=change_this_to_secure_app_password

# Redis Settings (Module Management & Caching)
REDIS_URL=redis://:redispassword@redis:6379/0
REDIS_PASSWORD=redispassword

# Module Management Settings
MODULE_REGISTRY_PATH=config/modules.json
LICENSE_ENCRYPTION_KEY=change-this-to-32-char-key-in-production-please-make-secure
DOCKER_REGISTRY_URL=https://registry.hub.docker.com
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
MAX_MODULES=50
MAX_MODULES_PER_USER=10
MODULE_INSTALL_TIMEOUT=300

# Trusted Docker Registries (comma-separated, for module installation security)
TRUSTED_REGISTRIES=registry.hub.docker.com,ghcr.io,gcr.io,docker.io,localhost

# License Validation Settings
LICENSE_VALIDATION_MODE=format
# LICENSE_SERVER_URL=https://your-license-server.com (optional, for online validation)
# LICENSE_SERVER_API_KEY=your-api-key (optional, for online validation)

# Anthropic Claude AI (Farm AI Chat)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ───────────────────────────────────────────────────────────────────────────
# Host ports — exposed by docker-compose.yml.
# Override these only when you need to host multiple instances on one box.
# ───────────────────────────────────────────────────────────────────────────
API_PORT=8000
USER_PORTAL_PORT=5173
USER_PORTAL_PROD_PORT=8081
MONGODB_PORT=27017
REDIS_PORT=6379
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ADMINER_PORT=8080
REGISTRY_PORT=5050
IOT_SIM_PORT=8090
FINANCE_PORT=8001

# Optional override for which nginx config file is bind-mounted into the
# nginx container. Defaults to ./nginx/nginx.dev.conf in dev compose and
# ./nginx/nginx.prod.conf when docker-compose.prod.yml is layered on top.
# Override here if you maintain a third profile (e.g., staging).
NGINX_CONF=./nginx/nginx.dev.conf

# Uvicorn worker count for the api service.
# Rule of thumb: 2 * CPU_cores + 1. Keep at 1 in dev if you want hot reload.
UVICORN_WORKERS=4

# Vite dev server — base URL for the frontend's API calls.
# Used by the user-portal build; leave empty to default to nginx proxy.
VITE_API_URL=

# ───────────────────────────────────────────────────────────────────────────
# Weather + Voice integrations (optional)
# ───────────────────────────────────────────────────────────────────────────
# Agricultural weather data — get a free key at https://weatherbit.io
WEATHERBIT_API_KEY=

# ElevenLabs text-to-speech (legacy voice features, currently unused).
# Leave blank unless re-enabling voice.
ELEVENLABS_API_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Backup service (the in-cluster mongodump container — opt-in via profile).
# Daily/weekly/monthly retention counts. Set ENCRYPT_BACKUPS=true and provide
# a 32-byte BACKUP_ENCRYPTION_KEY (AES-256) for at-rest encryption.
# ───────────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
ENCRYPT_BACKUPS=false
BACKUP_ENCRYPTION_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Finance microservice + outbox consumer (opt-in via docker-compose.finance.yml
# with `--profile finance`). Required only when finance is deployed.
# ───────────────────────────────────────────────────────────────────────────
FINANCE_OUTBOX_ENABLED=false
# Shared secret between main api and finance service (transactional outbox).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FINANCE_INGESTION_SECRET=dev-only-secret-change-in-prod

# MySQL backing store for the finance service.
FINANCE_MYSQL_PORT=3307
FINANCE_MYSQL_DATABASE=finance_db
FINANCE_MYSQL_ROOT_PASSWORD=rootpassword
FINANCE_MYSQL_USER=finance_user
FINANCE_MYSQL_PASSWORD=finance_password

# Outbox consumer tuning (background worker that ships events to finance).
CONSUMER_POLL_INTERVAL_SECONDS=2
CONSUMER_BATCH_SIZE=50
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_STALE_CLAIM_SECONDS=300
