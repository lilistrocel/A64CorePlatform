{
  "module_name": "purchasing",
  "display_name": "Purchasing",
  "version": "1.0.0",
  "description": "Purchasing master data: vendor master, purchase item master, payment terms with outbox-based finance sync.",
  "route_prefix": "/api/v1/purchasing",
  "dependencies": {
    "core": ">=1.3.0",
    "python": ">=3.11"
  },
  "database_collections": [
    "vendors",
    "purchase_items",
    "payment_terms"
  ],
  "permissions": [
    "purchasing.view",
    "purchasing.vendor.manage",
    "purchasing.item.manage",
    "purchasing.terms.manage"
  ],
  "license_required": false,
  "enabled_by_default": true,
  "core_module": true,
  "industries": ["all"],
  "industry_mode": "shared"
}
