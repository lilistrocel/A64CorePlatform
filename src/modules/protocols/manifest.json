{
  "module_name": "protocols",
  "display_name": "Protocols",
  "version": "1.0.0",
  "description": "Standard operating procedures — versioned, approved, and surfaced at the point of work via scope tags. Work records pin the protocol version they were carried out under.",
  "route_prefix": "/api/v1/protocols",
  "dependencies": {
    "core": ">=1.3.0",
    "python": ">=3.11"
  },
  "database_collections": [
    "protocols"
  ],
  "permissions": [
    "protocols.view",
    "protocols.author",
    "protocols.approve",
    "protocols.retire"
  ],
  "license_required": true,
  "enabled_by_default": true,
  "core_module": true,
  "industries": ["all"],
  "industry_mode": "shared"
}
